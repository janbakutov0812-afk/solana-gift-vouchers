# Solana network for wallet connection and confirmation (devnet is the default).
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public base URL of the escrow backend. Leave empty until it is deployed.
# The UI blocks funding if this is not configured.
VITE_VOUCHER_API_URL=
