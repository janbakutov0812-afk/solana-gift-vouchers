# Solana network for wallet connection and confirmation (devnet is the default).
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public base URL of the escrow backend. In the Vercel deployment this defaults
# to the current origin, where /api/escrow/* is served by the Vercel Functions.
VITE_VOUCHER_API_URL=

# Server-only Vercel Function settings. Never use the VITE_ prefix for secrets.
DATABASE_URL=
ESCROW_NETWORK=devnet
ESCROW_RPC_URL=https://api.devnet.solana.com
ESCROW_ALLOWED_ORIGINS=https://solana-gift-vouchers-nine.vercel.app
ESCROW_MASTER_KEY=
# Base58-encoded 64-byte Solana keypair secret (server-only; never VITE_).
ESCROW_FEE_PAYER_SECRET_KEY=
